{
  "name": "growth-blueprint",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:native": "python3 scripts/test-native.py",
    "android:debug": "npm run build && bash scripts/android.sh assembleDebug",
    "android:release": "python3 scripts/release.py",
    "android:test": "bash scripts/android.sh connectedDebugAndroidTest",
    "android:smoke": "tsx scripts/android-smoke.ts",
    "format": "prettier --write src tests e2e scripts/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
